#: extension.js:347
msgid "Open Dynamic Island"
msgstr "Dinamik Adayı aç"

#: extension.js:401
msgid "Close Dynamic Island"
msgstr "Dinamik Adayı kapat"

#: extension.js:432
msgid "Mute or unmute"
msgstr "Sesi kapat/aç"

#: extension.js:438
msgid "Volume"
msgstr "Ses düzeyi"

#: extension.js:508
msgid "Back"
msgstr "Geri"

#: extension.js:578
msgid "Previous"
msgstr "Önceki"

#: extension.js:579
msgid "Play or pause"
msgstr "Oynat/duraklat"

#: extension.js:580
msgid "Next"
msgstr "Sonraki"

#: extension.js:594
msgid "Open notification"
msgstr "Bildirimi aç"

#: extension.js:661 center.js:183
msgid "Notifications"
msgstr "Bildirimler"

#: extension.js:693 prefs.js:96
msgid "Now playing"
msgstr "Şimdi çalan"

#. Translators: battery percentage, e.g. "78%". Use %% for the percent sign.
#: extension.js:1543
#, javascript-format
msgid "%d%%"
msgstr "%%%d"

#: extension.js:1561
msgid "Fully charged"
msgstr "Dolu"

#: extension.js:1564
#, javascript-format
msgid "Charging, full in %s"
msgstr "Şarj oluyor, %s sonra dolu"

#: extension.js:1565
msgid "Charging"
msgstr "Şarj oluyor"

#: extension.js:1568
msgid "Plugged in, not charging"
msgstr "Takılı, şarj beklemede"

#: extension.js:1570
#, javascript-format
msgid "%s left"
msgstr "%s kaldı"

#: extension.js:1571
msgid "On battery"
msgstr "Pilde"

#: extension.js:1579 center.js:291
#, javascript-format
msgid "%d min"
msgstr "%d dk"

#: extension.js:1580
#, javascript-format
msgid "%d h"
msgstr "%d sa"

#: extension.js:1580
#, javascript-format
msgid "%d h %d min"
msgstr "%d sa %d dk"

#: extension.js:1715
msgid "Nothing is playing"
msgstr "Hiçbir şey çalmıyor"

#: prefs.js:13
msgid ""
"Dash to Panel moves the top bar into its own panel. Use one or the other."
msgstr ""
"Dash to Panel üst çubuğu kendi paneline taşıyor. İkisinden birini kullanın."

#: prefs.js:15
msgid ""
"Just Perfection can hide or restyle the top bar. Leave its panel options at "
"their defaults."
msgstr ""
"Just Perfection üst çubuğu gizleyebilir ya da görünümünü değiştirebilir. "
"Panel seçeneklerini varsayılanda bırakın."

#: prefs.js:17
msgid "Hide Top Bar hides the same bar the island replaces. Turn it off."
msgstr "Hide Top Bar, adanın yerini aldığı çubuğu gizliyor. Kapatın."

#: prefs.js:19
msgid "Open Bar restyles the top bar. Turn it off."
msgstr "Open Bar üst çubuğun görünümünü değiştiriyor. Kapatın."

#: prefs.js:21
msgid ""
"Blur my Shell: turn off its panel blur, or a strip can stay at the top of "
"the screen."
msgstr ""
"Blur my Shell: panel bulanıklığını kapatın, yoksa ekranın üstünde bir şerit "
"kalabilir."

#: prefs.js:39
msgid "Behaviour"
msgstr "Davranış"

#: prefs.js:43
msgid "Slide out of the way"
msgstr "Yoldan çekil"

#: prefs.js:44
msgid "Rest the pointer on the top edge to bring it back"
msgstr "Geri getirmek için imleci üst kenarda bekletin"

#: prefs.js:46
msgid "Never"
msgstr "Hiçbir zaman"

#: prefs.js:47
msgid "In fullscreen"
msgstr "Tam ekranda"

#: prefs.js:48
msgid "When a window reaches under it"
msgstr "Bir pencere altına girince"

#: prefs.js:56
msgid "Notifications in the island"
msgstr "Bildirimler adada"

#: prefs.js:57
msgid "In place of GNOME's banners"
msgstr "GNOME'un bildirim kutuları yerine"

#: prefs.js:60
msgid "Appearance"
msgstr "Görünüm"

#: prefs.js:62
msgid "Frosted glass"
msgstr "Buzlu cam"

#: prefs.js:63
msgid "Turn off for a plain dark island on slower graphics"
msgstr "Yavaş ekran kartlarında düz koyu ada için kapatın"

#: prefs.js:66
msgid "Width of the open island"
msgstr "Açık adanın genişliği"

#: prefs.js:75
msgid "Primary monitor"
msgstr "Ana monitör"

#. Translators: a monitor in the list, e.g. "Monitor 2 (DELL U2720Q)".
#: prefs.js:79 prefs.js:81
msgid "Monitor"
msgstr "Monitör"

#: prefs.js:90
msgid "Island"
msgstr "Ada"

#: prefs.js:91
msgid "What the island shows"
msgstr "Adada neler görünsün"

#: prefs.js:94
msgid "Notification center"
msgstr "Bildirim merkezi"

#: prefs.js:95
msgid "The bell on the left"
msgstr "Soldaki zil"

#: prefs.js:97
msgid "The bubble on the right"
msgstr "Sağdaki baloncuk"

#: prefs.js:98
msgid "Microphone and camera"
msgstr "Mikrofon ve kamera"

#: prefs.js:99
msgid "Shows while they are in use; the microphone turns green while you talk"
msgstr "Kullanılırken görünür; konuşurken mikrofon yeşile döner"

#: prefs.js:100
msgid "Connectivity"
msgstr "Bağlantı"

#: prefs.js:101
msgid "Wi-Fi, Bluetooth, tethering, VPN"
msgstr "Wi-Fi, Bluetooth, internet paylaşımı, VPN"

#: prefs.js:102 apps.js:26 apps.js:92 apps.js:109
msgid "Open apps"
msgstr "Açık uygulamalar"

#: prefs.js:103
msgid "Sliders"
msgstr "Kaydırıcılar"

#: prefs.js:104
msgid "Volume, microphone, brightness"
msgstr "Ses, mikrofon, parlaklık"

#: prefs.js:105
msgid "Toggles"
msgstr "Düğmeler"

#: prefs.js:106
msgid ""
"Power mode, dark style, Do Not Disturb and toggles from other extensions"
msgstr "Güç modu, karanlık stil, Rahatsız Etme ve diğer eklentilerin düğmeleri"

#: prefs.js:107
msgid "Other extensions' icons"
msgstr "Diğer eklentilerin simgeleri"

#: prefs.js:110
msgid "Command palette"
msgstr "Komut paleti"

#: prefs.js:111
msgid ""
"Super+Space: apps, calculator, timers, notes, Claude. Type ? to ask Claude, "
"n to take a note."
msgstr ""
"Super+Space: uygulamalar, hesap makinesi, zamanlayıcı, notlar, Claude. "
"Claude'a sormak için ?, not almak için n yaz."

#: prefs.js:114
msgid "Notes folder (searched, empty for none)"
msgstr "Not klasörü (aranır, boşsa arama yok)"

#: prefs.js:117
msgid "Quick notes go to (a path, or a folder inside the notes folder)"
msgstr "Hızlı notların yeri (bir yol ya da not klasörü içinde bir klasör)"

#: prefs.js:133
msgid "Compatibility"
msgstr "Uyumluluk"

#: prefs.js:134
msgid "These extensions also change the top bar"
msgstr "Bu eklentiler de üst çubuğu değiştiriyor"

#: prefs.js:148
msgid "About"
msgstr "Hakkında"

#: prefs.js:152
msgid "Report a problem or suggest an idea"
msgstr "Sorun bildir ya da fikir öner"

#: center.js:61 center.js:66
msgid "Do Not Disturb"
msgstr "Rahatsız Etme"

#: center.js:105
msgid "Clear"
msgstr "Temizle"

#: center.js:138
msgid "No notifications"
msgstr "Bildirim yok"

#: center.js:183
#, javascript-format
msgid "Notifications · %d"
msgstr "Bildirimler · %d"

#: center.js:270 activities.js:251
msgid "Dismiss"
msgstr "Kapat"

#: center.js:289
msgid "now"
msgstr "şimdi"

#: apps.js:36
msgid "No open apps"
msgstr "Açık uygulama yok"

#: charge.js:46 charge.js:53
msgid "Charge Limit"
msgstr "Şarj Sınırı"

#: charge.js:48
msgid "Open charge limit menu"
msgstr "Şarj sınırı menüsünü aç"

#: charge.js:54
msgid "Charging stops early to keep the battery healthy"
msgstr "Pil sağlığı için şarj erken durur"

#: charge.js:58
msgid "Stop at {n}%"
msgstr "Sınır: %{n}"

#: charge.js:63
msgid "Charge to 100% once"
msgstr "Bir kez %100 şarj et"

#: charge.js:97
msgid "{n}%"
msgstr "%{n}"

#: charge.js:97
msgid "Off"
msgstr "Kapalı"

#: charge.js:108
msgid "Health {n}%"
msgstr "Sağlık %{n}"

#: charge.js:110
msgid "{n} cycles"
msgstr "{n} döngü"

#: palette.js:34
msgid "Note"
msgstr "Not"

#: palette.js:69
msgid "Search, calculate, ? ask Claude, n take a note"
msgstr "Ara, hesapla, ? Claude'a sor, n not al"

#: palette.js:177
msgid "? question"
msgstr "? soru"

#: palette.js:177
msgid "Ask Claude"
msgstr "Claude'a sor"

#: palette.js:178
msgid "n text"
msgstr "n metin"

#: palette.js:178
msgid "Save a quick note"
msgstr "Hızlı not kaydet"

#: palette.js:179
msgid "25 min"
msgstr "25 dk"

#: palette.js:179
msgid "Start a timer"
msgstr "Zamanlayıcı başlat"

#: palette.js:180
msgid "12*7 or 5 km mi"
msgstr "12*7 ya da 5 km mi"

#: palette.js:180
msgid "Calculate and convert"
msgstr "Hesapla ve çevir"

#: palette.js:198 palette.js:208
msgid "Copy the result"
msgstr "Sonucu kopyala"

#: palette.js:217
#, javascript-format
msgid "Start a %s timer"
msgstr "%s zamanlayıcı başlat"

#: palette.js:218
msgid "Shown in the island while it runs"
msgstr "Çalışırken adada görünür"

#: palette.js:235
#, javascript-format
msgid "Search the web for “%s”"
msgstr "Web'de ara: “%s”"

#: palette.js:348
#, javascript-format
msgid "Save as a note: %s"
msgstr "Not olarak kaydet: %s"

#: palette.js:364
msgid "Note saved"
msgstr "Not kaydedildi"

#: palette.js:367
msgid "Could not save the note"
msgstr "Not kaydedilemedi"

#: palette.js:384
msgid "Copied"
msgstr "Kopyalandı"

#: palette.js:462
#, javascript-format
msgid "Ask Claude: %s"
msgstr "Claude'a sor: %s"

#: palette.js:463
msgid "The answer appears here"
msgstr "Cevap burada çıkar"

#: palette.js:494
msgid "Copy"
msgstr "Kopyala"

#: palette.js:496
msgid "Save as a note"
msgstr "Not olarak kaydet"

#: palette.js:522
msgid "Thinking…"
msgstr "Düşünüyor…"

#: palette.js:545
msgid "No answer came back."
msgstr "Cevap gelmedi."

#: palette.js:547
msgid "Claude could not answer."
msgstr "Claude cevap veremedi."

#: palette.js:551
#, javascript-format
msgid "Claude could not be started: %s"
msgstr "Claude başlatılamadı: %s"

#: activities.js:133
msgid "Timer"
msgstr "Zamanlayıcı"

#: activities.js:179
msgid "Time is up"
msgstr "Süre doldu"
