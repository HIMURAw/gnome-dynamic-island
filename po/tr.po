msgid ""
"Push the pointer against the left or right edge: the launcher and focus on "
"the left, tools on the right"
msgstr "İşaretçiyi sol ya da sağ kenara it: solda başlatıcı ve odak, sağda araçlar"

#: prefs.js:100
msgid "Microphone and camera"
msgstr "Mikrofon ve kamera"

