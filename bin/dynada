#!/usr/bin/env bash
# Live activities in Dynamic Island, from the terminal or any script.
#
#   dynada timer 25m [label]              countdown in the island
#   dynada run [-t title] -- cmd args...  run a command; the island shows it until it ends
#   dynada ci [dir]                       follow the GitHub Actions run of HEAD (needs gh)
#   dynada update ID TITLE [SUBTITLE] [ICON] [PROGRESS 0..1, -1 = none]
#   dynada end ID [MESSAGE] [ok|fail]
set -uo pipefail

call() {
    gdbus call --session --dest org.gnome.Shell --object-path /io/github/himuraw/DynamicIsland \
        --method "io.github.himuraw.DynamicIsland.$1" "${@:2}" >/dev/null
}

# The progress goes as a typed GVariant: a bare "-1" would read as an option to gdbus.
update() { call Update "$1" "$2" "${3:-}" "${4:-}" "@d ${5:--1}"; }
finish() { call End "$1" "${2:-}" "$([[ ${3:-ok} == ok ]] && echo true || echo false)"; }

seconds_of() {
    local s=$1 total=0 n
    if [[ $s =~ ^[0-9]+$ ]]; then echo $((s * 60)); return; fi
    while [[ $s =~ ^([0-9]+)(h|m|s)(.*)$ ]]; do
        n=${BASH_REMATCH[1]}
        case ${BASH_REMATCH[2]} in h) total=$((total + n * 3600)) ;; m) total=$((total + n * 60)) ;; s) total=$((total + n)) ;; esac
        s=${BASH_REMATCH[3]}
    done
    [[ -z $s && $total -gt 0 ]] && echo $total || return 1
}

cmd=${1:-help}
shift || true
case $cmd in
update) update "$@" ;;
end) finish "$@" ;;
timer)
    secs=$(seconds_of "${1:-}") || { echo "dynada timer: give a length like 25m, 1h30m, 90s or 10" >&2; exit 2; }
    call Timer "$secs" "${2:-}"
    ;;
run)
    title=""
    if [[ ${1:-} == -t ]]; then title=$2; shift 2; fi
    [[ ${1:-} == -- ]] && shift
    [[ $# -gt 0 ]] || { echo "dynada run: nothing to run" >&2; exit 2; }
    id="run-$$"
    update "$id" "${title:-$1}" "$*" utilities-terminal-symbolic -1
    "$@"
    status=$?
    if [[ $status -eq 0 ]]; then finish "$id" "$*" ok; else finish "$id" "$* (exit $status)" fail; fi
    exit $status
    ;;
ci)
    cd "${1:-.}" || exit 2
    command -v gh >/dev/null || { echo "dynada ci: needs the GitHub CLI (gh)" >&2; exit 2; }
    sha=$(git rev-parse HEAD) || exit 2
    repo=$(basename "$(git rev-parse --show-toplevel)")
    id="ci-$repo"
    update "$id" "CI · $repo" "waiting for the run" emblem-synchronizing-symbolic -1
    run=""
    for _ in $(seq 30); do
        run=$(gh run list --commit "$sha" -L 1 --json databaseId --jq '.[0].databaseId' 2>/dev/null)
        [[ -n $run ]] && break
        sleep 4
    done
    [[ -n $run ]] || { finish "$id" "no run found for ${sha:0:7}" fail; exit 1; }
    while :; do
        read -r status conclusion done total name < <(gh run view "$run" --json status,conclusion,jobs,workflowName --jq \
            '[.status, (.conclusion // "-"), ([.jobs[].steps[]? | select(.status=="completed")] | length),
              ([.jobs[].steps[]?] | length), .workflowName] | @tsv' 2>/dev/null)
        if [[ $status == completed ]]; then
            if [[ $conclusion == success ]]; then finish "$id" "$name" ok; exit 0; fi
            finish "$id" "$name: $conclusion" fail; exit 1
        fi
        progress=-1
        [[ ${total:-0} -gt 0 ]] && progress=$(awk "BEGIN{print $done/$total}")
        update "$id" "CI · $repo" "${name:-…} · ${status:-queued}" emblem-synchronizing-symbolic "$progress"
        sleep 6
    done
    ;;
*)
    sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'
    ;;
esac
